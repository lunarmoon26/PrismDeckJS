{
  "name": "prismdeckjs-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:core && npm run dev --workspace=@prismdeck/studio",
    "export:html": "npm run build:core --silent && node scripts/export-html.mjs",
    "build:core": "npm run build --workspace=prismdeckjs",
    "build": "npm run build:core && npm run build --workspace=@prismdeck/studio",
    "test": "npm run test --workspace=prismdeckjs",
    "test:e2e": "npm run build:core --silent && playwright test",
    "test:watch": "npm run test:watch --workspace=prismdeckjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
