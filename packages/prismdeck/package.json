{
  "name": "prismdeckjs",
  "version": "0.2.1",
  "description": "Browser-native spatial presentation SDK and agent adapters for editable spatial decks",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lunarmoon26.github.io/PrismDeckJS/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunarmoon26/PrismDeckJS.git",
    "directory": "packages/prismdeck"
  },
  "bugs": {
    "url": "https://github.com/lunarmoon26/PrismDeckJS/issues"
  },
  "keywords": [
    "presentation",
    "pptx",
    "odp",
    "three.js",
    "stereo",
    "browser"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/prism-deck.min.js",
  "jsdelivr": "./dist/prism-deck.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/prism-deck.min.js"
    },
    "./server": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    },
    "./opencode": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    },
    "./deepseek": {
      "types": "./dist/deepseek.d.ts",
      "import": "./dist/deepseek.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./schema": "./schema/prismdeck.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "skills",
    "cordis.patch.yml",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    "plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --config vite.browser.config.ts && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:agents": "node ../../.agents/skills/develop-prismdeckjs/scripts/sync-metadata.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@dimforge/rapier3d-compat": "0.20.0",
    "ajv": "^8.17.1",
    "echarts": "6.1.0",
    "fflate": "^0.8.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@opencode-ai/plugin": "^1.18.21",
    "vite": "^7.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@opencode-ai/plugin": "^1.18.21"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "author": "Haochuan Zhang",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
