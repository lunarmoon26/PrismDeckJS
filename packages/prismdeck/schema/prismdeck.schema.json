{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismdeckjs.dev/schema/prismdeck-0.5.0.json",
  "title": "PrismDeck document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "metadata", "size", "layouts", "slides"],
  "properties": {
    "schemaVersion": { "const": "0.5.0" },
    "id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["presentation", "template"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "modifiedAt": { "type": "string" },
        "sourceFormat": { "enum": ["pptx", "odp", "prismdeck", "native"] }
      }
    },
    "size": { "$ref": "#/$defs/size" },
    "backgroundScene": { "$ref": "#/$defs/backgroundScene" },
    "layouts": { "type": "array", "items": { "$ref": "#/$defs/layout" } },
    "slides": { "type": "array", "items": { "$ref": "#/$defs/slide" } }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "slides": {
            "contains": {
              "type": "object",
              "required": ["backgroundCamera"]
            }
          }
        },
        "required": ["slides"]
      },
      "then": { "required": ["backgroundScene"] }
    },
    {
      "if": {
        "properties": {
          "slides": {
            "contains": {
              "type": "object",
              "required": ["backgroundCamera"],
              "properties": {
                "backgroundCamera": { "type": "object", "required": ["focusBody"] }
              }
            }
          }
        },
        "required": ["slides"]
      },
      "then": {
        "required": ["backgroundScene"],
        "properties": {
          "backgroundScene": {
            "type": "object",
            "required": ["solarSystem"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "color": { "type": "string", "minLength": 1, "maxLength": 200 },
    "galaxyColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "backgroundScene": {
      "oneOf": [
        { "$ref": "#/$defs/galaxyBackgroundScene" }
      ]
    },
    "galaxyBackgroundScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seed", "starCount", "rotationDegreesPerSecond", "coreColor", "armColor", "solColor"],
      "properties": {
        "type": { "const": "galaxy" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "starCount": { "type": "integer", "minimum": 1000, "maximum": 20000 },
        "rotationDegreesPerSecond": { "type": "number", "minimum": -10, "maximum": 10 },
        "coreColor": { "$ref": "#/$defs/galaxyColor" },
        "armColor": { "$ref": "#/$defs/galaxyColor" },
        "solColor": { "$ref": "#/$defs/galaxyColor" },
        "backdropAssetId": { "$ref": "#/$defs/id" },
        "solarSystem": { "$ref": "#/$defs/galaxySolarSystem" }
      }
    },
    "galaxySolarSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textureAssetIds": { "$ref": "#/$defs/galaxySolarTextureAssetIds" }
      }
    },
    "galaxySolarTextureAssetIds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sol": { "$ref": "#/$defs/id" },
        "mercury": { "$ref": "#/$defs/id" },
        "venus": { "$ref": "#/$defs/id" },
        "earth": { "$ref": "#/$defs/id" },
        "earthClouds": { "$ref": "#/$defs/id" },
        "earthSpecular": { "$ref": "#/$defs/id" },
        "luna": { "$ref": "#/$defs/id" },
        "mars": { "$ref": "#/$defs/id" },
        "jupiter": { "$ref": "#/$defs/id" },
        "saturn": { "$ref": "#/$defs/id" },
        "uranus": { "$ref": "#/$defs/id" },
        "neptune": { "$ref": "#/$defs/id" },
        "saturnRing": { "$ref": "#/$defs/id" },
        "stars": { "$ref": "#/$defs/id" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["z", "rotationX", "rotationY", "rotationZ", "scaleX", "scaleY"],
      "properties": {
        "z": { "type": "number" },
        "rotationX": { "type": "number" },
        "rotationY": { "type": "number" },
        "rotationZ": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "shape", "density", "restitution", "friction"],
      "properties": {
        "body": { "enum": ["fixed", "dynamic", "kinematic", "sensor"] },
        "shape": { "enum": ["cuboid", "ball"] },
        "density": { "type": "number", "minimum": 0 },
        "restitution": { "type": "number", "minimum": 0, "maximum": 1 },
        "friction": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["pptx", "odp", "prismdeck", "native"] },
        "part": { "type": "string" },
        "nativeId": { "type": "string" },
        "nativeType": { "type": "string" }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "index": { "type": "integer" },
        "prompt": { "type": "string" }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "fontSize", "fontWeight", "fontStyle", "color", "align", "verticalAlign", "lineHeight"],
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "fontWeight": { "type": "number", "minimum": 1, "maximum": 1000 },
        "fontStyle": { "enum": ["normal", "italic"] },
        "color": { "$ref": "#/$defs/color" },
        "align": { "enum": ["left", "center", "right"] },
        "verticalAlign": { "enum": ["top", "middle", "bottom"] },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "borderStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "width", "style"],
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "width": { "type": "number", "minimum": 0 },
        "style": { "enum": ["solid", "dashed", "dotted"] }
      }
    },
    "tableCellBorders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "$ref": "#/$defs/borderStyle" },
        "right": { "$ref": "#/$defs/borderStyle" },
        "bottom": { "$ref": "#/$defs/borderStyle" },
        "left": { "$ref": "#/$defs/borderStyle" }
      }
    },
    "tableCellPadding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "type": "number", "minimum": 0 },
        "right": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 },
        "left": { "type": "number", "minimum": 0 }
      }
    },
    "tableCellStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "$ref": "#/$defs/color" },
        "textStyle": { "$ref": "#/$defs/textStyle" },
        "verticalAlign": { "enum": ["top", "middle", "bottom"] },
        "padding": { "$ref": "#/$defs/tableCellPadding" },
        "borders": { "$ref": "#/$defs/tableCellBorders" }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "text"],
      "properties": {
        "column": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "columnSpan": { "type": "integer", "minimum": 1 },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "header": { "type": "boolean" },
        "style": { "$ref": "#/$defs/tableCellStyle" }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "cells"],
      "properties": {
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "cells": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/tableCell" } }
      }
    },
    "chartPointStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/borderStyle" }
      }
    },
    "nullableNumber": { "type": ["number", "null"] },
    "chartPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "label": { "type": "string" },
        "value": { "$ref": "#/$defs/nullableNumber" },
        "x": { "$ref": "#/$defs/nullableNumber" },
        "y": { "$ref": "#/$defs/nullableNumber" },
        "size": { "$ref": "#/$defs/nullableNumber" },
        "open": { "$ref": "#/$defs/nullableNumber" },
        "high": { "$ref": "#/$defs/nullableNumber" },
        "low": { "$ref": "#/$defs/nullableNumber" },
        "close": { "$ref": "#/$defs/nullableNumber" },
        "values": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/nullableNumber" } },
        "style": { "$ref": "#/$defs/chartPointStyle" }
      }
    },
    "chartMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "shape", "size"],
      "properties": {
        "visible": { "type": "boolean" },
        "shape": { "enum": ["circle", "square", "diamond", "triangle"] },
        "size": { "type": "number", "minimum": 0 }
      }
    },
    "chartDataLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible"],
      "properties": {
        "visible": { "type": "boolean" },
        "showValue": { "type": "boolean" },
        "showCategory": { "type": "boolean" },
        "showSeries": { "type": "boolean" },
        "showPercent": { "type": "boolean" },
        "position": { "type": "string" },
        "style": { "$ref": "#/$defs/textStyle" }
      }
    },
    "chartSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "points"],
      "properties": {
        "name": { "type": "string" },
        "points": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/chartPoint" } },
        "color": { "$ref": "#/$defs/color" },
        "numberFormat": { "type": "string" },
        "marker": { "$ref": "#/$defs/chartMarker" },
        "smooth": { "type": "boolean" },
        "line": { "$ref": "#/$defs/borderStyle" },
        "dataLabels": { "$ref": "#/$defs/chartDataLabels" }
      }
    },
    "chartPlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "series"],
      "properties": {
        "type": { "enum": ["bar", "line", "area", "pie", "doughnut", "radar", "scatter", "bubble", "stock", "surface", "histogram", "pareto", "boxWhisker", "waterfall", "treemap", "sunburst", "funnel", "regionMap", "unknown"] },
        "series": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/chartSeries" } },
        "grouping": { "enum": ["standard", "clustered", "stacked", "percentStacked"] },
        "direction": { "enum": ["bar", "column"] },
        "axisIds": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/id" } },
        "holeSize": { "type": "number", "minimum": 0, "maximum": 90 },
        "firstSliceAngle": { "type": "number" }
      }
    },
    "chartAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "position", "visible"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["category", "date", "value"] },
        "position": { "enum": ["top", "right", "bottom", "left"] },
        "visible": { "type": "boolean" },
        "reversed": { "type": "boolean" },
        "title": { "type": "string" },
        "titleStyle": { "$ref": "#/$defs/textStyle" },
        "labelStyle": { "$ref": "#/$defs/textStyle" },
        "numberFormat": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "majorGridlines": { "$ref": "#/$defs/borderStyle" },
        "line": { "$ref": "#/$defs/borderStyle" }
      }
    },
    "chartLegend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "position"],
      "properties": {
        "visible": { "type": "boolean" },
        "position": { "enum": ["top", "right", "bottom", "left", "topRight"] },
        "overlay": { "type": "boolean" },
        "style": { "$ref": "#/$defs/textStyle" }
      }
    },
    "elementBase": {
      "type": "object",
      "required": ["id", "type", "name", "frame", "transform", "opacity", "visible", "renderOrder"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["text", "image", "shape", "table", "chart", "unsupported"] },
        "name": { "type": "string" },
        "frame": { "$ref": "#/$defs/frame" },
        "transform": { "$ref": "#/$defs/transform" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visible": { "type": "boolean" },
        "renderOrder": { "type": "integer" },
        "thickness": { "type": "number", "minimum": 0 },
        "physics": { "$ref": "#/$defs/physics" },
        "source": { "$ref": "#/$defs/source" },
        "placeholder": { "$ref": "#/$defs/placeholder" }
      }
    },
    "textElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        { "type": "object", "required": ["text", "style"], "properties": { "type": { "const": "text" }, "text": { "type": "string" }, "style": { "$ref": "#/$defs/textStyle" } } }
      ],
      "unevaluatedProperties": false
    },
    "imageElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        { "type": "object", "required": ["assetId", "fit"], "properties": { "type": { "const": "image" }, "assetId": { "$ref": "#/$defs/id" }, "alt": { "type": "string" }, "fit": { "enum": ["contain", "cover", "fill"] } } }
      ],
      "unevaluatedProperties": false
    },
    "shapeElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        { "type": "object", "required": ["shape", "fill", "stroke", "strokeWidth"], "properties": { "type": { "const": "shape" }, "shape": { "enum": ["rectangle", "roundedRectangle", "ellipse", "line", "custom"] }, "fill": { "$ref": "#/$defs/color" }, "stroke": { "$ref": "#/$defs/color" }, "strokeWidth": { "type": "number", "minimum": 0 }, "text": { "type": "string" }, "textStyle": { "$ref": "#/$defs/textStyle" } } }
      ],
      "unevaluatedProperties": false
    },
    "tableElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        { "type": "object", "required": ["columns", "rows", "style"], "properties": { "type": { "const": "table" }, "columns": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "number", "exclusiveMinimum": 0 } }, "rows": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/tableRow" } }, "style": { "$ref": "#/$defs/tableCellStyle" } } }
      ],
      "unevaluatedProperties": false
    },
    "chartElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        { "type": "object", "required": ["plots", "axes"], "properties": { "type": { "const": "chart" }, "plots": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/chartPlot" } }, "axes": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/chartAxis" } }, "title": { "type": "string" }, "titleStyle": { "$ref": "#/$defs/textStyle" }, "legend": { "$ref": "#/$defs/chartLegend" }, "displayBlanksAs": { "enum": ["gap", "zero", "span"] }, "background": { "$ref": "#/$defs/color" }, "plotBackground": { "$ref": "#/$defs/color" } } }
      ],
      "unevaluatedProperties": false
    },
    "unsupportedElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        { "type": "object", "required": ["reason"], "properties": { "type": { "const": "unsupported" }, "reason": { "type": "string", "minLength": 1 }, "fallbackText": { "type": "string" } } }
      ],
      "unevaluatedProperties": false
    },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/textElement" },
        { "$ref": "#/$defs/imageElement" },
        { "$ref": "#/$defs/shapeElement" },
        { "$ref": "#/$defs/tableElement" },
        { "$ref": "#/$defs/chartElement" },
        { "$ref": "#/$defs/unsupportedElement" }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "elements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
      }
    },
    "slideTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationMs"],
      "properties": {
        "type": { "enum": ["cut", "fade", "slide"] },
        "durationMs": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "backgroundCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "allOf": [
        {
          "if": {
            "required": ["view"],
            "properties": { "view": { "const": "horizon" } }
          },
          "then": { "required": ["focusBody"] }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["orbitAzimuthDegrees"] },
              { "required": ["orbitElevationDegrees"] }
            ]
          },
          "then": {
            "required": ["view", "focusBody"],
            "properties": { "view": { "const": "horizon" } }
          }
        }
      ],
      "properties": {
        "x": { "type": "number", "minimum": -20, "maximum": 20 },
        "y": { "type": "number", "minimum": -20, "maximum": 20 },
        "z": { "type": "number", "minimum": -10, "maximum": 10 },
        "distance": { "type": "number", "minimum": 0.001, "maximum": 100 },
        "view": { "enum": ["top", "tilt", "horizon"] },
        "focusBody": { "enum": ["sol", "mercury", "venus", "earth", "luna", "mars", "jupiter", "saturn", "uranus", "neptune"] },
        "orbitAzimuthDegrees": { "type": "number", "minimum": -180, "maximum": 180 },
        "orbitElevationDegrees": { "type": "number", "minimum": -78, "maximum": 78 },
        "transitionDurationMs": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "durationMs", "background", "elements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "layoutId": { "$ref": "#/$defs/id" },
        "durationMs": { "type": "number", "minimum": 0 },
        "transition": { "$ref": "#/$defs/slideTransition" },
        "backgroundCamera": { "$ref": "#/$defs/backgroundCamera" },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" },
        "notes": { "type": "string" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
      }
    }
  }
}
